{
  "version": 1,
  "file": "surroundweather.json",
  "patches": {},
  "settings": [
    {
      "type": "separator",
      "title": "Weather beds"
    },
    {
      "code": "ReplaceVanillaWeatherBeds",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Replace vanilla weather beds",
      "comment": "Swap the vanilla weather tracks (rain, wind, hail, rumble, distant thunder) for 5.1 surround recordings."
    },
    {
      "type": "separator",
      "title": "Leaf Rustle"
    },
    {
      "code": "EnableLeafRustleEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Enable leaf rustle emitters",
      "comment": "Rustling leaves from the trees around you in the wind."
    },
    {
      "code": "LeafRustleVolumeMultiplier",
      "type": "float",
      "default": 1.75,
      "clientSide": true,
      "ingui": "Leaf rustle volume multiplier",
      "comment": "Scale foliage rustle emitter volume.",
      "range": {
        "min": 0.0,
        "max": 5.0,
        "step": 0.05
      }
    },
    {
      "code": "LeafRustlePitchVariationMultiplier",
      "type": "float",
      "default": 1.5,
      "clientSide": true,
      "ingui": "Leaf rustle pitch variation",
      "comment": "Scale foliage rustle pitch variation.",
      "range": {
        "min": 0.0,
        "max": 5.0,
        "step": 0.05
      }
    },
    {
      "code": "LeafRustleEmitterSpacing",
      "type": "float",
      "default": 5.0,
      "clientSide": true,
      "ingui": "Leaf rustle spacing",
      "comment": "Blocks between rustles playing at once (lower: denser).",
      "range": {
        "min": 0.0,
        "max": 16.0,
        "step": 0.5
      }
    },
    {
      "code": "LeafRustleFadeOutSeconds",
      "type": "float",
      "default": 0.8,
      "clientSide": true,
      "ingui": "Leaf rustle fade-out",
      "comment": "Seconds a rustle takes to fade once it falls behind you or out of range.",
      "range": {
        "min": 0.1,
        "max": 4.0,
        "step": 0.1
      }
    },
    {
      "type": "separator",
      "title": "Rain Emitters"
    },
    {
      "code": "EnableRainEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Enable rain emitters",
      "comment": "Rain landing on the ground around you, from where it lands."
    },
    {
      "type": "separator",
      "title": "Experimental: rain from surfaces"
    },
    {
      "code": "ExperimentalRainSurfaceEmitters",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Rain from surfaces (experimental)",
      "comment": "Rain plays from the ground, roofs and canopies it lands on instead of a bed at your head. Takes effect when the world is next loaded."
    },
    {
      "code": "RainSurfaceEmitterCount",
      "type": "integer",
      "default": 24,
      "clientSide": true,
      "ingui": "Rain emitters",
      "comment": "Rain emitters around you at full rain.",
      "range": {
        "min": 2,
        "max": 32,
        "step": 1
      }
    },
    {
      "code": "RainSurfaceEmitterSpacing",
      "type": "float",
      "default": 2.5,
      "clientSide": true,
      "ingui": "Rain emitter spacing",
      "comment": "Blocks between rain emitters (lower packs more into a small opening).",
      "range": {
        "min": 1.0,
        "max": 12.0,
        "step": 0.5
      }
    },
    {
      "code": "RainSurfaceEmitterLifetimeSeconds",
      "type": "float",
      "default": 5.0,
      "clientSide": true,
      "ingui": "Rain emitter lifetime",
      "comment": "Seconds an emitter plays before its place moves on (lower keeps the rain shifting).",
      "range": {
        "min": 1.0,
        "max": 20.0,
        "step": 0.5
      }
    },
    {
      "code": "RainSurfaceEmitterRadius",
      "type": "float",
      "default": 18.0,
      "clientSide": true,
      "ingui": "Rain emitter radius",
      "comment": "How far out (blocks) the rain emitters are placed.",
      "range": {
        "min": 6.0,
        "max": 48.0,
        "step": 1.0
      }
    },
    {
      "code": "RainSurfaceEmitterVolume",
      "type": "float",
      "default": 1.0,
      "clientSide": true,
      "ingui": "Rain emitter volume",
      "comment": "Scales the rain emitters' loudness.",
      "range": {
        "min": 0.0,
        "max": 3.0,
        "step": 0.05
      }
    },
    {
      "code": "ShowRainSurfaceEmitterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show rain surface emitter visuals",
      "comment": "Draw the rain emitters when debug tools are enabled."
    },
    {
      "type": "separator",
      "title": "Debug"
    },
    {
      "code": "EnableDebugTools",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Enable debug tools",
      "comment": "Enable the rain emitter debug renderer."
    },
    {
      "code": "ShowLeafRustleDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show leaf rustle debug visuals",
      "comment": "Render leaf rustle emitter debug visuals when debug tools are enabled."
    },
    {
      "code": "ShowRainEmitterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show rain emitter debug visuals",
      "comment": "Render rain emitter debug visuals when debug tools are enabled."
    }
  ]
}
