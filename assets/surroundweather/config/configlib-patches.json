{
  "version": 1,
  "file": "surroundweather.json",
  "patches": {},
  "settings": [
    {
      "type": "separator",
      "title": "Weather beds"
    },
    {
      "code": "ReplaceVanillaWeatherBeds",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Replace vanilla weather beds",
      "comment": "Swap the vanilla weather tracks (rain, wind, hail, rumble, distant thunder) for 5.1 surround recordings."
    },
    {
      "type": "separator",
      "title": "Leaf Rustle"
    },
    {
      "code": "EnableLeafRustleEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Enable leaf rustle emitters",
      "comment": "Rustling leaves from the trees around you in the wind."
    },
    {
      "code": "LeafRustleVolumeMultiplier",
      "type": "float",
      "default": 1.75,
      "clientSide": true,
      "ingui": "Leaf rustle volume multiplier",
      "comment": "Scale foliage rustle emitter volume.",
      "range": {
        "min": 0.0,
        "max": 5.0,
        "step": 0.05
      }
    },
    {
      "code": "LeafRustlePitchVariationMultiplier",
      "type": "float",
      "default": 1.5,
      "clientSide": true,
      "ingui": "Leaf rustle pitch variation",
      "comment": "Scale foliage rustle pitch variation.",
      "range": {
        "min": 0.0,
        "max": 5.0,
        "step": 0.05
      }
    },
    {
      "code": "LeafRustleEmitterSpacing",
      "type": "float",
      "default": 5.0,
      "clientSide": true,
      "ingui": "Leaf rustle spacing",
      "comment": "Blocks between rustles playing at once (lower: denser).",
      "range": {
        "min": 0.0,
        "max": 16.0,
        "step": 0.5
      }
    },
    {
      "code": "LeafRustleFadeOutSeconds",
      "type": "float",
      "default": 0.8,
      "clientSide": true,
      "ingui": "Leaf rustle fade-out",
      "comment": "Seconds a rustle takes to fade once it falls behind you or out of range.",
      "range": {
        "min": 0.1,
        "max": 4.0,
        "step": 0.1
      }
    },
    {
      "type": "separator",
      "title": "Rain Emitters"
    },
    {
      "code": "EnableRainEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Enable rain emitters",
      "comment": "Rain landing on the ground around you, from where it lands."
    },
    {
      "type": "separator",
      "title": "Experimental: rain from surfaces"
    },
    {
      "code": "ExperimentalRainSurfaceEmitters",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Rain from surfaces (experimental)",
      "comment": "Rain plays from the ground, roofs and canopies it lands on instead of a bed at your head. Takes effect when the world is next loaded."
    },
    {
      "code": "RainSurfaceEmitterCount",
      "type": "integer",
      "default": 48,
      "clientSide": true,
      "ingui": "Rain emitters",
      "comment": "The most rain emitters at once; the grid's nearest cells win.",
      "range": {
        "min": 4,
        "max": 128,
        "step": 1
      }
    },
    {
      "code": "RainSurfaceEmitterSpacing",
      "type": "float",
      "default": 3.0,
      "clientSide": true,
      "ingui": "Rain emitter spacing",
      "comment": "Blocks between rain emitters near you; each ring further out doubles it.",
      "range": {
        "min": 1.0,
        "max": 12.0,
        "step": 0.5
      }
    },
    {
      "code": "RainSurfaceEmitterLifetimeSeconds",
      "type": "float",
      "default": 3.0,
      "clientSide": true,
      "ingui": "Rain emitter lifetime",
      "comment": "Seconds an emitter plays before its place moves on (lower keeps the rain shifting).",
      "range": {
        "min": 1.0,
        "max": 20.0,
        "step": 0.5
      }
    },
    {
      "code": "RainSurfaceEmitterRadius",
      "type": "float",
      "default": 18.0,
      "clientSide": true,
      "ingui": "Rain emitter radius",
      "comment": "How far out (blocks) the rain emitters are placed.",
      "range": {
        "min": 6.0,
        "max": 48.0,
        "step": 1.0
      }
    },
    {
      "code": "RainSurfaceEmitterVolume",
      "type": "float",
      "default": 1.0,
      "clientSide": true,
      "ingui": "Rain emitter volume",
      "comment": "Scales the rain emitters' loudness.",
      "range": {
        "min": 0.0,
        "max": 3.0,
        "step": 0.05
      }
    },
    {
      "code": "ShowRainSurfaceEmitterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show rain surface emitter visuals",
      "comment": "Draw the rain emitters when debug tools are enabled."
    },
    {
      "type": "separator",
      "title": "Experimental: wind from the open"
    },
    {
      "code": "ExperimentalWindEmitters",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Wind from the open (experimental)",
      "comment": "Wind plays from the open ground around you, loudest from upwind, instead of a bed at your head. Takes effect when the world is next loaded."
    },
    {
      "code": "WindEmitterVolume",
      "type": "float",
      "default": 1.0,
      "clientSide": true,
      "ingui": "Wind emitter volume",
      "comment": "Scales the wind emitters' loudness.",
      "range": {
        "min": 0.0,
        "max": 3.0,
        "step": 0.05
      }
    },
    {
      "type": "separator",
      "title": "Experimental: rain on windows"
    },
    {
      "code": "ExperimentalWindowRainEmitters",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Rain on windows (experimental)",
      "comment": "Each window near you gets its own quiet emitter just outside the pane, instead of vanilla's one sound for every pane at once."
    },
    {
      "code": "RainWindowVolume",
      "type": "float",
      "default": 0.4,
      "clientSide": true,
      "ingui": "Window rain volume",
      "comment": "How loud one window is in full rain.",
      "range": {
        "min": 0.0,
        "max": 2.0,
        "step": 0.05
      }
    },
    {
      "code": "RainWindowRadius",
      "type": "float",
      "default": 10.0,
      "clientSide": true,
      "ingui": "Window rain radius",
      "comment": "How far out (blocks) windows are given emitters; every pane within it gets one.",
      "range": {
        "min": 2.0,
        "max": 32.0,
        "step": 1.0
      }
    },
    {
      "code": "RainWindowMaxCount",
      "type": "integer",
      "default": 24,
      "clientSide": true,
      "ingui": "Window rain emitters",
      "comment": "The most window emitters at once; the nearest panes win.",
      "range": {
        "min": 1,
        "max": 64,
        "step": 1
      }
    },
    {
      "code": "ExperimentalWaterWaveEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Water emitters",
      "comment": "Water sounds from the water, an emitter at a time, instead of one sound for a whole lake."
    },
    {
      "code": "WaterWaveVolume",
      "type": "float",
      "default": 0.5,
      "clientSide": true,
      "ingui": "Water volume",
      "comment": "How loud the water lapping at a shore is; open water is quieter than this.",
      "range": {
        "min": 0.0,
        "max": 2.0,
        "step": 0.05
      }
    },
    {
      "code": "WaterWaveRadius",
      "type": "float",
      "default": 24.0,
      "clientSide": true,
      "ingui": "Water radius",
      "comment": "How far out (blocks) the water is given emitters.",
      "range": {
        "min": 8.0,
        "max": 64.0,
        "step": 1.0
      }
    },
    {
      "code": "WaterWaveCount",
      "type": "integer",
      "default": 8,
      "clientSide": true,
      "ingui": "Water emitter count",
      "comment": "The most water emitters at once; the nearest water wins.",
      "range": {
        "min": 1,
        "max": 64,
        "step": 1
      }
    },
    {
      "code": "WaterWaveSpacing",
      "type": "float",
      "default": 8.0,
      "clientSide": true,
      "ingui": "Water emitter spacing",
      "comment": "Blocks between water emitters around the listener; they thin out further off.",
      "range": {
        "min": 2.0,
        "max": 24.0,
        "step": 1.0
      }
    },
    {
      "code": "ExperimentalFlowingWaterEmitters",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Creek and fall emitters",
      "comment": "Running water sounds from the water that makes it, instead of one sound for a whole river."
    },
    {
      "code": "FlowingWaterVolume",
      "type": "float",
      "default": 0.5,
      "clientSide": true,
      "ingui": "Creek and fall volume",
      "comment": "How loud a fall is; rapids and a creek are quieter than this.",
      "range": {
        "min": 0.0,
        "max": 2.0,
        "step": 0.05
      }
    },
    {
      "code": "FlowingWaterRadius",
      "type": "float",
      "default": 20.0,
      "clientSide": true,
      "ingui": "Creek and fall radius",
      "comment": "How far out (blocks) running water is given emitters.",
      "range": {
        "min": 6.0,
        "max": 48.0,
        "step": 1.0
      }
    },
    {
      "code": "FlowingWaterCount",
      "type": "integer",
      "default": 10,
      "clientSide": true,
      "ingui": "Creek and fall emitter count",
      "comment": "The most running-water emitters at once; the nearest water wins.",
      "range": {
        "min": 1,
        "max": 48,
        "step": 1
      }
    },
    {
      "code": "FlowingWaterSpacing",
      "type": "float",
      "default": 3.0,
      "clientSide": true,
      "ingui": "Creek and fall spacing",
      "comment": "Blocks between them: a creek is a line a block or two wide, so they sit close.",
      "range": {
        "min": 1.0,
        "max": 16.0,
        "step": 1.0
      }
    },
    {
      "code": "PlaceAmbientSoundsOnTheirBlocks",
      "type": "boolean",
      "default": true,
      "clientSide": true,
      "ingui": "Ambient sounds on their blocks",
      "comment": "Play a block's ambient sound (rain on windows) from the nearest block that makes it, instead of vanilla's bounding box, which puts it on your head indoors."
    },
    {
      "type": "separator",
      "title": "Debug"
    },
    {
      "code": "EnableDebugTools",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Enable debug tools",
      "comment": "Enable the rain emitter debug renderer."
    },
    {
      "code": "ShowLeafRustleDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show leaf rustle debug visuals",
      "comment": "Render leaf rustle emitter debug visuals when debug tools are enabled."
    },
    {
      "code": "ShowRainEmitterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show rain emitter debug visuals",
      "comment": "Render rain emitter debug visuals when debug tools are enabled."
    },
    {
      "code": "ShowWindEmitterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show wind emitter visuals",
      "comment": "Draw the wind emitters when debug tools are enabled."
    },
    {
      "code": "ShowWaterWaveDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show water emitters",
      "comment": "Draw where the water emitters are."
    },
    {
      "code": "ShowFlowingWaterDebugVisuals",
      "type": "boolean",
      "default": false,
      "clientSide": true,
      "ingui": "Show creek and fall emitters",
      "comment": "Draw where the running-water emitters are."
    }
  ]
}
